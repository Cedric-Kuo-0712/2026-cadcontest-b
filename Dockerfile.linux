# Build Linux regr_fail_bucketing binary (Option A submission).

FROM python:3.10-slim-bookworm

WORKDIR /work

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt regr_fail_bucketing.spec build_submission.sh README.md ./
COPY src/ src/
COPY B_samples_20260516/problem/benchmark_set_1/ B_samples_20260516/problem/benchmark_set_1/

RUN pip install --no-cache-dir -r requirements.txt pyinstaller \
    && ./build_submission.sh
